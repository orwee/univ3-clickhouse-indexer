# Names only. Copy to ~/secrets/airflow.env (chmod 600), outside the repository, and fill it in;
# AIRFLOW_ENV_FILE points elsewhere. Nothing real goes in this file. Generate each secret:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# and the Fernet key (urlsafe base64 of 32 bytes):
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# Password of the metadata database, and the connection string that uses it (same password).
POSTGRES_PASSWORD=CHANGE_ME
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:CHANGE_ME@airflow-postgres/airflow
# Encrypts connection passwords stored in the metadata database.
AIRFLOW__CORE__FERNET_KEY=CHANGE_ME
# Shared by the API server and the scheduler: signs the tokens tasks use to report back.
AIRFLOW__API_AUTH__JWT_SECRET=CHANGE_ME
# Password of the user `admin` in the web UI.
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME
# The only API key the DAG needs (read through config.require_api_key). Not the Nansen key and
# not the model key: tasks never call either.
ALCHEMY_API_KEY=CHANGE_ME
# The failure alert (airflow/dags/pipeline_alert.py): a fine-grained token with write access to
# this repository's issues and nothing else, and the number of the issue "Pipeline alerts" (#101).
# Leave the token as CHANGE_ME and no alert is sent; the tasks run as before.
GITHUB_ALERT_TOKEN=CHANGE_ME
GITHUB_ALERT_ISSUE=CHANGE_ME
