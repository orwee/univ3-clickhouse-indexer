# Credentials of the THROW-AWAY demo server. Not secrets: this ClickHouse lives only inside
# the demo's private Docker network, publishes no port, and is deleted when the demo ends.
CLICKHOUSE_DB=demo
CLICKHOUSE_USER=demo
CLICKHOUSE_PASSWORD=demo-not-a-secret
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=0
CH_HOST=clickhouse-demo
CH_PORT=8123
# The grants of clickhouse/users.d/agent_reader.xml name the dbt database literally, so the
# demo builds into the same name as the real server. It is a throw-away server.
DBT_TARGET_DATABASE=onchain_dbt

# The read-only user. The server reads the hash; the runner connects with the password.
# Not a secret either: the hash is the SHA-256 of the demo password on the last line.
AGENT_READER_PASSWORD_SHA256=2c1ff7023983e2d5d21898b5ef25ccf80bfb0d18aa52b052a8bd9f8b46a6ee0d
AGENT_READER_HOST=clickhouse-demo
AGENT_READER_PORT=8123
AGENT_READER_DB=onchain_dbt
AGENT_READER_USER=agent_reader
AGENT_READER_PASSWORD=demo-reader-not-a-secret
